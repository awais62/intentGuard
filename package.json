{
  "name": "intentguard",
  "version": "0.1.0",
  "private": true,
  "description": "IntentGuard — the intent layer for AI coding agents",
  "author": "Awais Aziz",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @intentguard/web dev",
    "start:web": "pnpm --filter @intentguard/web start",
    "test": "pnpm --filter @intentguard/core test",
    "cli": "node packages/cli/dist/index.js",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "prettier": "^3.4.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
